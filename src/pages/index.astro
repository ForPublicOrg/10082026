---
// Landing page. Apple-product-page style: the entire first viewport is the
// poster illustration (no visible site title/header — the poster carries
// its own titling), a CTA + scroll cue sit on it, and a short scroll
// storyline reveals underneath. See docs/design-spec.md §7 for the history
// of this route (it has flipped between "feed-as-landing" and "banner +
// context page" more than once on 2026-07-21; this is the latest state).
import Base from "../layouts/Base.astro";
import { loadVideos, loadTimeline, publicVideos } from "../lib/schema";
import { MAX_UPLOAD_LABEL } from "../lib/upload-limits";
import { SITE_URL } from "../config";

const videos = publicVideos(loadVideos());
const timeline = loadTimeline();

const ogImage = `${SITE_URL}/banner/poster-wide.jpg`;
---

<Base
  title="Home"
  description="On 10 August 2026, thousands of students marched on the Jharkhand Legislative Assembly in Ranchi and were met with water cannon, tear gas and a lathi charge. This is an archive of video posted publicly by the people who were there, each entry linking back to the original post."
  ogImage={ogImage}
  hideHeader
  overlayNav
  hideFooter
>
  <!-- The poster already carries the date/title text; this heading exists
       for SEO and screen readers only, never rendered visibly. -->
  <h1 class="sr-only">10 08 2026 — The Day Jharkhand Marched</h1>

  <section class="hero">
    <picture>
      <!-- Desktop / wide viewports: owner-supplied 16:9 poster artwork
           (1672x941 native — full-res source PNGs live in
           archive-originals/banner-source/, git-ignored). Only native-or-
           smaller widths are offered; a 1920/2560 candidate would just be
           an upscale of this same source. -->
      <source
        media="(min-width: 768px)"
        type="image/webp"
        srcset="/banner/poster-wide-1280.webp 1280w, /banner/poster-wide-1672.webp 1672w"
        sizes="100vw"
      />
      <source
        media="(min-width: 768px)"
        type="image/jpeg"
        srcset="/banner/poster-wide.jpg"
      />
      <!-- Mobile / narrow viewports: owner-supplied 2:3 portrait poster
           (1024x1536 native), same no-upscaling rule. -->
      <source
        type="image/webp"
        srcset="/banner/poster-portrait-640.webp 640w, /banner/poster-portrait-1024.webp 1024w"
        sizes="100vw"
      />
      <img
        src="/banner/poster-portrait.jpg"
        alt="Illustrated documentary-collage poster titled Jharkhand Protest Archive: the date 10.08.2026 over scenes of the Ranchi march — protesters holding signs demanding a CBI probe and an end to paper leaks, police using a water cannon at the Vidhan Sabha barricades — surrounded by a leaked exam paper, a WhatsApp chat, a handwritten list of demands and a press card."
        width="1024"
        height="1536"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="hero-img"
      />
    </picture>

    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="hero-overlay">
      <!-- Scroll cue sits ABOVE the CTA in this stack (unusual order) on
           purpose: the whole overlay is bottom-anchored to --hero-strip-h
           (see .hero-overlay below), so whichever element is LAST in the
           stack ends up glued to that anchor line, right above the values
           strip. Putting the CTA last, not the scroll cue, is what pulls the
           button down off the seated figure's face/torso and onto the
           quieter scattered-papers/book ground area at the bottom of the
           artwork — see the CSS comment on .hero-overlay for the measurement
           this is based on. -->
      <div class="scroll-cue">
        <span class="scroll-cue-chevron" aria-hidden="true"></span>
        <span class="scroll-cue-label">Scroll</span>
      </div>

      <a href="/feed" class="cta-primary">Show me proof</a>
    </div>
  </section>

  <div class="content-col storyline">
    <!-- Memorial lede: the thesis line that opens the storyline, the first
         text read after scrolling past the poster. Date-led and restrained
         to match the archive's documentation-first voice — the epithet is the
         site's own memorial framing, not a claim about any media item. -->
    <section class="reveal lede" data-reveal>
      <p class="lede-kicker">10 August 2026</p>
      <h2 class="lede-title">The Day Jharkhand Marched</h2>
      <p class="lede-sub">
        The day a movement against leaked papers reached the gates of the
        Vidhan Sabha.
      </p>
    </section>

    <section class="reveal story-block" data-reveal>
      <h2 class="text-lg font-semibold">What happened</h2>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        On 10 August 2026, the seventeenth day of a movement against leaked
        recruitment-exam papers, thousands of students marched from Jaipal
        Singh Munda Stadium towards the Jharkhand Legislative Assembly in
        Ranchi. They broke through police barricades and were met with water
        cannon, tear gas and a lathi charge.
      </p>
    </section>

    <section class="reveal story-block" data-reveal>
      <h2 class="text-lg font-semibold">What this is</h2>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        An archive of publicly available video from that day and the movement
        around it, kept with its original sources and labelled by how much of
        it has actually been verified.
      </p>
      <p class="counts">
        {videos.length} video{videos.length === 1 ? "" : "s"} archived
        &middot; {timeline.length} timeline event{
          timeline.length === 1 ? "" : "s"
        }
      </p>
    </section>

    <!-- Progressive enhancement: a real <form> that posts JSON via the
         inline script below. Unlike takedown.astro this has no no-JS
         fallback — a two-step upload with a progress bar has no sane plain
         POST equivalent, so /api/submit-video and /api/upload/:id (see
         src/worker.ts) both just 400 a non-JSON caller. -->
    <section class="reveal story-block" data-reveal>
      <h2 class="text-lg font-semibold">Submit a video</h2>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        Have footage from the movement? Share a link to where you posted it,
        or upload the raw file directly if you never posted it anywhere.
      </p>

      <form
        id="submit-video-form"
        class="mt-6 flex flex-col gap-5 border-t border-border pt-6"
      >
        <div class="flex gap-5 text-sm" role="radiogroup" aria-label="How are you sharing this?">
          <label class="flex items-center gap-2">
            <input type="radio" name="submit-mode" value="url" checked />
            I have a link
          </label>
          <label class="flex items-center gap-2">
            <input type="radio" name="submit-mode" value="upload" />
            I have raw footage
          </label>
        </div>

        <div id="submit-video-url-field" class="flex flex-col gap-1.5">
          <label for="video-url" class="text-sm font-semibold">Link to the post</label>
          <input
            id="video-url"
            name="url"
            type="url"
            placeholder="https://..."
            class="min-h-11 rounded-lg border border-border bg-surface px-3 text-sm text-text placeholder:text-tertiary"
          />
        </div>

        <div id="submit-video-file-field" class="flex flex-col gap-1.5" style="display:none">
          <label for="video-file" class="text-sm font-semibold">Video file</label>
          <input
            id="video-file"
            name="file"
            type="file"
            accept="video/*"
            class="text-sm text-text file:mr-3 file:min-h-11 file:rounded-lg file:border-0 file:bg-accent file:px-4 file:text-sm file:font-semibold file:text-bg"
          />
          <p class="text-xs leading-relaxed text-muted">
            Up to {MAX_UPLOAD_LABEL}. For anything larger, upload it elsewhere and share the link instead.
          </p>
          <div id="submit-video-progress-wrap" style="display:none">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-surface">
              <div id="submit-video-progress-bar" class="h-full w-0 bg-accent"></div>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="video-event-date" class="text-sm font-semibold">
            When did this happen? <span class="font-normal text-muted">(optional)</span>
          </label>
          <input
            id="video-event-date"
            name="eventDate"
            type="datetime-local"
            class="min-h-11 rounded-lg border border-border bg-surface px-3 text-sm text-text"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="video-description" class="text-sm font-semibold">
            Description <span class="font-normal text-muted">(optional)</span>
          </label>
          <textarea
            id="video-description"
            name="description"
            maxlength="2000"
            rows="4"
            placeholder="What does this show? Where was it filmed?"
            class="rounded-lg border border-border bg-surface px-3 py-2 text-sm leading-relaxed text-text placeholder:text-tertiary"
          ></textarea>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="video-contact" class="text-sm font-semibold">
            How to reach you <span class="font-normal text-muted">(optional)</span>
          </label>
          <input
            id="video-contact"
            name="contact"
            type="text"
            maxlength="300"
            placeholder="Email or social handle"
            class="min-h-11 rounded-lg border border-border bg-surface px-3 text-sm text-text placeholder:text-tertiary"
          />
        </div>

        {/* Honeypot. Hidden from people, filled in by bots — see src/worker.ts. */}
        <div class="hp" aria-hidden="true">
          <label for="video-website">Leave this field empty</label>
          <input id="video-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-col gap-3">
          <button
            type="submit"
            class="min-h-11 rounded-lg bg-accent px-4 text-sm font-semibold text-bg"
          >
            Submit video
          </button>
          <p id="submit-video-status" role="status" aria-live="polite" class="text-sm"></p>
        </div>
      </form>
    </section>
  </div>

  <!-- Vercel Web Analytics (landing page only). Plain-HTML integration:
       when the site is deployed on Vercel with Web Analytics enabled, the
       platform serves /_vercel/insights/script.js and collects page views;
       everywhere else (wrangler dev, the Cloudflare deploy) the request
       404s and the deferred script is a silent no-op. Same-origin, so it
       needs no CSP changes. is:inline keeps Astro from bundling it. -->
  <script is:inline>
    window.va =
      window.va ||
      function () {
        (window.vaq = window.vaq || []).push(arguments);
      };
  </script>
  <script is:inline defer src="/_vercel/insights/script.js"></script>
</Base>

<style>
  .hero {
    position: relative;
    /* Never 100vh on mobile: that includes area the browser chrome can
       cover/uncover, which would clip the CTA. 100svh is the guaranteed
       visible minimum. */
    /* End the poster ABOVE the floating nav rather than behind it — with a
       full-100svh hero the artwork's bottom edge would sit underneath the
       opaque nav bar. Reserving the nav's height means the whole poster is
       actually visible, which is the point of showing it at all. */
    height: calc(100svh - var(--app-nav-h) - env(safe-area-inset-bottom));
    width: 100%;
    overflow: hidden;
    background: var(--color-bg);
    /* With the owner-supplied posters shown whole via `contain` (see
       .hero-img), this is no longer tied to any in-artwork strip: it is
       simply how far above the hero's bottom edge the CTA/scroll-cue
       overlay anchors. On mobile the 2:3 poster letterboxes top and bottom
       against the page's own black, so the overlay usually sits in (or
       near) the bottom band rather than over the artwork. The overlay's
       max(--hero-strip-h, nav-clearance) floor (below) still guarantees
       the CTA never sits behind the bottom nav. */
    --hero-strip-h: 10%;
  }

  @media (min-width: 768px) {
    .hero {
      --hero-strip-h: 13%;
      /* Desktop nav is a fixed left sidebar (no header on the landing
         page either), so it claims no vertical space here — the hero can
         take the full viewport height. */
      height: 100svh;
    }
  }

  .hero-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    /* `contain`, on both breakpoints — a deliberate reversal of the
       previous posters' `cover` tuning, because the owner-supplied artwork
       changes the trade-offs that decision was based on:
       1. The owner asked for the images to be shown COMPLETELY — every
          crop was cutting real content here (title band, collage documents,
          police line), not disposable margin like the old poster's sky.
       2. The old pillarboxing complaint doesn't reproduce: the phone poster
          is 2:3 (WIDER than any phone hero box, so `contain` fills the full
          width and letterboxes top/bottom, never down the sides), and both
          posters have near-black grungy edges that dissolve into the
          hero's --color-bg letterbox instead of meeting it at a hard seam.
       3. The desktop poster is exactly 16:9 — on the most common desktop
          and laptop viewports `contain` is a full-bleed perfect fit, and on
          anything wider/shorter it letterboxes symmetrically into black. */
    object-fit: contain;
    object-position: center;
  }

  /* Bottom scrim so the CTA and scroll cue stay legible over arbitrary
     artwork pixels, without darkening the whole poster. Runs to the hero's
     true bottom edge on both breakpoints so the artwork (or its letterbox
     band, now that .hero-img uses `contain`) always fades into the page's
     own --color-bg instead of ending in a visible seam. */
  .hero-scrim {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 36%;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.92) 0%,
      rgba(0, 0, 0, 0.3) 45%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
  }

  .hero-overlay {
    position: absolute;
    left: 0;
    right: 0;
    /* Anchored above the poster's own values strip (see --hero-strip-h on
       .hero) so the CTA/scroll-cue never sit on top of it — and, as a
       floor, always clears the floating bottom nav (mobile only — fixed at
       the bottom of the viewport there, see Base.astro) even on a viewport
       short enough that the strip's measured height would otherwise
       undercut the nav bar. Desktop overrides this below since its nav is
       a left sidebar with no bottom footprint to clear. */
    bottom: max(
      var(--hero-strip-h),
      calc(var(--app-nav-h) + env(safe-area-inset-bottom) + 0.85rem)
    );
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding: 0 1.25rem 0.5rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .hero-overlay {
      /* No bottom bar to clear on desktop (left sidebar instead) — just
         the strip, plus a small fixed floor for very short viewports. */
      bottom: max(var(--hero-strip-h), 1rem);
    }
  }

  .cta-primary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-bg);
    padding: 0.85rem 2.25rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .cta-primary:hover {
    opacity: 0.9;
  }

  .scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-muted);
  }

  .scroll-cue-chevron {
    width: 10px;
    height: 10px;
    border-right: 1.5px solid var(--color-muted);
    border-bottom: 1.5px solid var(--color-muted);
    transform: rotate(45deg);
  }

  .scroll-cue-label {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue {
      animation: scroll-cue-bounce 1.6s ease-in-out infinite;
    }
  }

  @keyframes scroll-cue-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(6px);
    }
  }

  /* --- Scroll storyline ------------------------------------------------ */

  .storyline {
    padding-top: 4.5rem;
    padding-bottom: 3rem;
  }

  .story-block {
    padding-top: 4rem;
    padding-bottom: 4rem;
    border-top: 1px solid var(--color-border);
  }

  .story-block:first-child {
    padding-top: 0;
    border-top: none;
  }

  /* --- Memorial lede: opens the storyline (first text after the poster) -- */

  .lede {
    text-align: center;
    padding-bottom: 1.5rem;
  }

  .lede-kicker {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .lede-title {
    margin: 0.7rem 0 0;
    font-size: clamp(1.5rem, 6vw, 2.05rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-text);
  }

  .lede-sub {
    margin: 0.85rem auto 0;
    max-width: 26rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .counts {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  /* --- "Submit a video" form ------------------------------------------- */

  /* Off-screen rather than display:none — some bots skip inputs that are
     display:none, but will happily fill one that is merely positioned away.
     Same trick as takedown.astro's own .hp; duplicated here rather than
     shared because Astro scopes <style> per component. */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Progressive enhancement: sections are visible by default (this rule is
     NOT inside a prefers-reduced-motion or JS-only gate). landing.ts only
     ever ADDS a class that hides them again for the staged-reveal
     animation, and only when JS runs AND the user has no reduced-motion
     preference — see src/scripts/landing.ts. If JS never runs, or the
     IntersectionObserver never fires, content simply stays visible. */
  .reveal {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .reveal.js-enhanced {
      opacity: 0;
      transform: translateY(28px);
      transition:
        opacity 700ms ease,
        transform 700ms ease;
    }

    .reveal.js-enhanced.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script src="../scripts/landing.ts"></script>

<script>
  import { MAX_UPLOAD_BYTES, TOO_LARGE_MESSAGE } from "../lib/upload-limits";

  const COULD_NOT_REACH =
    "Could not reach the server. Please check your connection and try again.";

  /**
   * Carries a message that is safe to show the submitter. Exists so the submit
   * handler can tell "the server answered and refused, here's why" apart from
   * "we never got a reply". Until 2026-07-28 both rejected with the same opaque
   * Error and everything was reported as a connection problem — including a
   * clear 413, which meant the real cause never reached either the submitter or
   * us.
   */
  class UploadError extends Error {
    userMessage: string;
    constructor(userMessage: string) {
      super(userMessage);
      this.name = "UploadError";
      this.userMessage = userMessage;
    }
  }

  /**
   * The Worker answers failures with `{ ok: false, error }`. Cloudflare's own
   * edge errors do not — the plan-level request-body 413 in particular is
   * generated before the Worker runs and returns an HTML page — so fall back to
   * the status code when the body isn't our JSON.
   */
  function uploadErrorMessage(xhr: XMLHttpRequest): string {
    try {
      const parsed = JSON.parse(xhr.responseText) as { error?: string };
      if (typeof parsed.error === "string" && parsed.error) return parsed.error;
    } catch {
      // Not JSON — fall through to the status-based messages below.
    }
    if (xhr.status === 413) return TOO_LARGE_MESSAGE;
    if (xhr.status === 429) return "Uploads are at capacity right now. Please try again later.";
    if (xhr.status === 0) return COULD_NOT_REACH;
    return `The upload failed (error ${xhr.status}). Please try again, or share a link instead.`;
  }

  function initSubmitVideoForm() {
    const form = document.getElementById("submit-video-form");
    if (!(form instanceof HTMLFormElement)) return;
    if (form.dataset.enhanced === "true") return;
    form.dataset.enhanced = "true";

    const urlField = document.getElementById("submit-video-url-field");
    const fileField = document.getElementById("submit-video-file-field");
    const progressWrap = document.getElementById("submit-video-progress-wrap");
    const progressBar = document.getElementById("submit-video-progress-bar");
    const status = document.getElementById("submit-video-status");
    const button = form.querySelector('button[type="submit"]');
    const fileInput = document.getElementById("video-file");
    const urlInput = document.getElementById("video-url");

    function currentMode(): string {
      const checked = form!.querySelector('input[name="submit-mode"]:checked');
      return checked instanceof HTMLInputElement ? checked.value : "url";
    }

    function syncMode() {
      const mode = currentMode();
      if (urlField instanceof HTMLElement) urlField.style.display = mode === "url" ? "flex" : "none";
      if (fileField instanceof HTMLElement) fileField.style.display = mode === "upload" ? "flex" : "none";
      // Only the field for the active mode should be required/validated.
      if (urlInput instanceof HTMLInputElement) urlInput.required = mode === "url";
      if (fileInput instanceof HTMLInputElement) fileInput.required = mode === "upload";
    }

    form.querySelectorAll('input[name="submit-mode"]').forEach((input) => {
      input.addEventListener("change", syncMode);
    });
    syncMode();

    function setStatus(text: string) {
      if (status) status.textContent = text;
    }

    function setBusy(busy: boolean, label?: string) {
      if (!(button instanceof HTMLButtonElement)) return;
      button.disabled = busy;
      if (label) button.textContent = label;
    }

    function fieldValue(id: string): string {
      const el = document.getElementById(id);
      return el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement ? el.value : "";
    }

    function uploadFile(id: number, file: File): Promise<void> {
      return new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        xhr.open("PUT", `/api/upload/${id}`);
        xhr.setRequestHeader("content-type", file.type);
        xhr.upload.addEventListener("progress", (event) => {
          if (event.lengthComputable && progressBar instanceof HTMLElement) {
            progressBar.style.width = `${Math.round((event.loaded / event.total) * 100)}%`;
          }
        });
        xhr.addEventListener("load", () => {
          if (xhr.status >= 200 && xhr.status < 300) resolve();
          else reject(new UploadError(uploadErrorMessage(xhr)));
        });
        // Only fires when the request never completed at all (connection
        // dropped, DNS, CORS). Anything the server or the edge actually
        // answered — including a 4xx/5xx — arrives via `load` above.
        xhr.addEventListener("error", () => reject(new UploadError(COULD_NOT_REACH)));
        xhr.addEventListener("abort", () => reject(new UploadError("The upload was cancelled.")));
        xhr.addEventListener("timeout", () =>
          reject(new UploadError("The upload timed out. Please try again.")),
        );
        xhr.send(file);
      });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const mode = currentMode();
      const eventDate = fieldValue("video-event-date");
      const description = fieldValue("video-description");
      const contact = fieldValue("video-contact");
      const website = fieldValue("video-website");

      setStatus("");
      setBusy(true, "Sending…");

      try {
        if (mode === "url") {
          const response = await fetch("/api/submit-video", {
            method: "POST",
            headers: { "content-type": "application/json", accept: "application/json" },
            body: JSON.stringify({
              mode: "url",
              url: fieldValue("video-url"),
              eventDate,
              description,
              contact,
              website,
            }),
          });
          const result = (await response.json()) as {
            ok?: boolean;
            error?: string;
            prUrl?: string;
          };

          if (response.ok && result.ok) {
            form.reset();
            syncMode();
            setStatus("Thank you — this will be reviewed.");
            // Vercel deployments queue link submissions into a public pull
            // request (api/submit-video.js) and return its URL; the
            // Cloudflare Worker path stores to the private inbox instead
            // and returns no prUrl. Only ever a link to github.com — never
            // submitter data.
            if (result.prUrl && status) {
              const link = document.createElement("a");
              link.href = result.prUrl;
              link.target = "_blank";
              link.rel = "noopener noreferrer";
              link.textContent = "Track it in the public review queue ↗";
              link.className = "text-accent";
              status.append(" ");
              status.append(link);
            }
            setBusy(false, "Sent");
            return;
          }
          setStatus(result.error ?? "Something went wrong. Please try again.");
          setBusy(false, "Submit video");
          return;
        }

        // Upload mode: create the row first, then stream the file in.
        const file = fileInput instanceof HTMLInputElement ? fileInput.files?.[0] : undefined;
        if (!file) {
          setStatus("Please choose a file to upload.");
          setBusy(false, "Submit video");
          return;
        }
        if (file.size > MAX_UPLOAD_BYTES) {
          setStatus(TOO_LARGE_MESSAGE);
          setBusy(false, "Submit video");
          return;
        }

        const createResponse = await fetch("/api/submit-video", {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({
            mode: "upload",
            eventDate,
            description,
            contact,
            website,
            filename: file.name,
            mimeType: file.type,
            fileSize: file.size,
          }),
        });
        const created = (await createResponse.json()) as { ok?: boolean; error?: string; id?: number };

        if (!createResponse.ok || !created.ok || !created.id) {
          setStatus(created.error ?? "Something went wrong. Please try again.");
          setBusy(false, "Submit video");
          return;
        }

        if (progressWrap instanceof HTMLElement) progressWrap.style.display = "block";
        await uploadFile(created.id, file);

        form.reset();
        syncMode();
        if (progressWrap instanceof HTMLElement) progressWrap.style.display = "none";
        if (progressBar instanceof HTMLElement) progressBar.style.width = "0%";
        setStatus("Thank you — this will be reviewed.");
        setBusy(false, "Sent");
      } catch (error) {
        if (progressWrap instanceof HTMLElement) progressWrap.style.display = "none";
        // An UploadError already carries a message written for the submitter.
        // Anything else here is a genuinely failed fetch() for the two
        // /api/submit-video calls above, where "couldn't reach us" is accurate.
        setStatus(error instanceof UploadError ? error.userMessage : COULD_NOT_REACH);
        setBusy(false, "Submit video");
      }
    });
  }

  initSubmitVideoForm();
  // Astro's ClientRouter swaps documents without a full reload.
  document.addEventListener("astro:page-load", initSubmitVideoForm);
</script>
